# Copy to key.properties and fill in after creating the upload keystore.
# NEVER commit key.properties or *.jks to git.
#
# Create keystore (run from android/):
#   keytool -genkeypair -v -storetype PKCS12 -keystore app/upload-keystore.jks -alias upload -keyalg RSA -keysize 2048 -validity 10000
#
storePassword=YOUR_STORE_PASSWORD
keyPassword=YOUR_KEY_PASSWORD
keyAlias=upload
storeFile=upload-keystore.jks
